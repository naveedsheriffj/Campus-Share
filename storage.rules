rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /resource-images/{userId}/{allPaths=**} {
      // Anyone can view resource listing images
      allow read: if true;
      
      // Only the authenticated user can upload to their folder
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Only the owner can delete their images
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
